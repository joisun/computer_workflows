Backend: {
  shape: rectangle
  style: {
    fill: "#f0f0f0"
  }
  
  App: {
    shape: rectangle
    label: "app.js - 主应用入口"
  }
  
  Routes: {
    shape: rectangle
    style: {
      fill: "#e0e0e0"
    }
    
    DockerRoutes: {
      shape: rectangle
      label: "dockerRoutes.js - Docker 相关 API"
    }
    FlowRoutes: {
      shape: rectangle
      label: "flowRoutes.js - 流水线 API"
    }
    
    BatchDeployRoutes: {
      shape: rectangle
      style: {
        fill: "#d0d0d0"
      }
      
      BD_StartBatchDeploy: {
        shape: rectangle
        label: "POST /deploy/batch-deploy\n- 开始批量部署"
      }
      BD_GetDeploymentStatus: {
        shape: rectangle
        label: "GET /deploy/status/:transactionId\n- 获取部署状态"
      }
      BD_GetRecentDeployments: {
        shape: rectangle
        label: "GET /deploy/recent-deployments\n- 获取最近部署"
      }
      BD_StopDeployment: {
        shape: rectangle
        label: "POST /deploy/stop/:transactionId/:pipelineName\n- 停止单个部署"
      }
      BD_StopAllDeployments: {
        shape: rectangle
        label: "POST /deploy/stop-all/:transactionId\n- 停止所有部署"
      }
      BD_RerunDeployment: {
        shape: rectangle
        label: "POST /deploy/rerun/:transactionId\n- 重新运行部署"
      }
    }
  }
  
  Services: {
    shape: rectangle
    style: {
      fill: "#e0e0e0"
    }
    
    BatchDeployService: {
      shape: rectangle
      style: {
        fill: "#d0d0d0"
      }
      
      BDS_Constructor: {
        shape: rectangle
        label: "constructor()\n- 初始化服务"
      }
      BDS_GenerateTransactionId: {
        shape: rectangle
        label: "generateTransactionId()\n- 生成事务ID"
      }
      BDS_CreateAliCodeUpBranch: {
        shape: rectangle
        label: "createAliCodeUpBranch(pipeline, branchName)\n- 创建代码分支"
      }
      BDS_DeployToFlow: {
        shape: rectangle
        label: "deployToFlow(pipeline, branchName)\n- 部署到Flow"
      }
      BDS_GetBusySlotCount: {
        shape: rectangle
        label: "getBusySlotCount()\n- 获取忙碌槽位数"
      }
      BDS_ProcessDeployments: {
        shape: rectangle
        label: "processDeployments()\n- 处理部署任务"
      }
      BDS_CheckRunningPipelines: {
        shape: rectangle
        label: "checkRunningPipelines()\n- 检查运行中的管道"
      }
      BDS_StartProcessor: {
        shape: rectangle
        label: "startProcessor()\n- 启动处理器"
      }
      BDS_ShouldStopProcessor: {
        shape: rectangle
        label: "shouldStopProcessor()\n- 检查是否应停止处理器"
      }
      BDS_HandleDependentProjects: {
        shape: rectangle
        label: "handleDependentProjects(pipelineNames, branch)\n- 处理依赖项目"
      }
      BDS_StartBatchDeploy: {
        shape: rectangle
        label: "startBatchDeploy(pipelineNames, branch, remark)\n- 开始批量部署"
      }
      BDS_CancelPipelineRun: {
        shape: rectangle
        label: "cancelPipelineRun(pipeline, runId)\n- 取消流水线运行"
      }
    }
    
    DeploymentRedisService: {
      shape: rectangle
      style: {
        fill: "#d0d0d0"
      }
      
      DRS_AcquireLock: {
        shape: rectangle
        label: "acquireLock(transactionId, pipelineName)\n- 获取锁"
      }
      DRS_ReleaseLock: {
        shape: rectangle
        label: "releaseLock(transactionId, pipelineName, lockValue)\n- 释放锁"
      }
      DRS_SavePipelineTransaction: {
        shape: rectangle
        label: "savePipelineTransaction(transactionId, pipeline)\n- 保存单个事务"
      }
      DRS_SaveTransaction: {
        shape: rectangle
        label: "saveTransaction(transactionId, transactions)\n- 保存多个事务"
      }
      DRS_GetTransaction: {
        shape: rectangle
        label: "getTransaction(transactionId)\n- 获取事务"
      }
      DRS_UpdateTransactionStatus: {
        shape: rectangle
        label: "updateTransactionStatus(transactionId, pipelineName, updates)\n- 更新事务状态"
      }
      DRS_GetRecentTransactions: {
        shape: rectangle
        label: "getRecentTransactions({ page, pageSize })\n- 获取最近事务"
      }
      DRS_GetDeploymentsByStatus: {
        shape: rectangle
        label: "getDeploymentsByStatus(status)\n- 获取特定状态的部署"
      }
    }
  }
}


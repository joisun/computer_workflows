graph TD
    %% 前端模块
    subgraph Frontend["前端 - Vue.js 应用"]
        Client["Client 应用"]
        PublicAssets["静态资源文件"]
        
        subgraph FrontendSrc["前端源代码"]
            VueComponents["Vue 组件"]
            VueRouter["Vue Router 路由"]
            VueX["VueX 状态管理"]
        end
    end

    %% 后端模块
    subgraph Backend["后端 - Node.js 应用"]
        App["app.js - 主应用入口"]
        
        %% 路由层
        subgraph Routes["路由层 - Express Router"]
            DockerRoutes["dockerRoutes.js - Docker 相关 API"]
            FlowRoutes["flowRoutes.js - 流水线 API"]
            
            subgraph BatchDeployRoutes["batchDeployRoutes.js - 批量部署路由"]
                BD_StartBatchDeploy["POST /deploy/batch-deploy - 开始批量部署"]
                BD_GetDeploymentStatus["GET /deploy/status/:transactionId - 获取部署状态"]
                BD_GetRecentDeployments["GET /deploy/recent-deployments - 获取最近部署"]
                BD_StopDeployment["POST /deploy/stop/:transactionId/:pipelineName - 停止单个部署"]
                BD_StopAllDeployments["POST /deploy/stop-all/:transactionId - 停止所有部署"]
                BD_RerunDeployment["POST /deploy/rerun/:transactionId - 重新运行部署"]
            end
        end
        
        %% 服务层
        subgraph Services["服务层"]
            subgraph BatchDeployService["batchDeployService.js - 批量部署服务"]
                BDS_Constructor["constructor() - 初始化服务"]
                BDS_GenerateTransactionId["generateTransactionId() - 生成事务ID"]
                BDS_CreateAliCodeUpBranch["createAliCodeUpBranch(pipeline, branchName) - 创建代码分支"]
                BDS_DeployToFlow["deployToFlow(pipeline, branchName) - 部署到Flow"]
                BDS_GetBusySlotCount["getBusySlotCount() - 获取忙碌槽位数"]
                BDS_ProcessDeployments["processDeployments() - 处理部署任务"]
                BDS_CheckRunningPipelines["checkRunningPipelines() - 检查运行中的管道"]
                BDS_StartProcessor["startProcessor() - 启动处理器"]
                BDS_ShouldStopProcessor["shouldStopProcessor() - 检查是否应停止处理器"]
                BDS_HandleDependentProjects["handleDependentProjects(pipelineNames, branch) - 处理依赖项目"]
                BDS_StartBatchDeploy["startBatchDeploy(pipelineNames, branch, remark) - 开始批量部署"]
                BDS_CancelPipelineRun["cancelPipelineRun(pipeline, runId) - 取消流水线运行"]
            end
            
            subgraph DeploymentRedisService["deploymentRedisService.js - Redis部署服务"]
                DRS_AcquireLock["acquireLock(transactionId, pipelineName) - 获取锁"]
                DRS_ReleaseLock["releaseLock(transactionId, pipelineName, lockValue) - 释放锁"]
                DRS_SavePipelineTransaction["savePipelineTransaction(transactionId, pipeline) - 保存单个事务"]
                DRS_SaveTransaction["saveTransaction(transactionId, transactions) - 保存多个事务"]
                DRS_GetTransaction["getTransaction(transactionId) - 获取事务"]
                DRS_UpdateTransactionStatus["updateTransactionStatus(transactionId, pipelineName, updates) - 更新事务状态"]
                DRS_GetRecentTransactions["getRecentTransactions({ page, pageSize }) - 获取最近事务"]
                DRS_GetDeploymentsByStatus["getDeploymentsByStatus(status) - 获取特定状态的部署"]
            end
        end
        
        %% 工具模块
        subgraph Utils["工具模块"]
            subgraph FlowHelper["flow-helper.js - Flow 助手"]
                FH_Constructor["constructor() - 初始化"]
                FH_GetRepoUrlByPipelineId["getRepoUrlByPipelineId(pipelineId) - 获取仓库URL"]
                FH_GetPipelineIdByName["getPipelineIdByName(pipelineName) - 获取流水线ID"]
                FH_GetPipelines["getPipelines(params) - 获取流水线列表"]
                FH_TriggerPipelineRun["triggerPipelineRun(pipelineName, branch) - 触发流水线运行"]
                FH_GetPipelineRun["getPipelineRun(pipelineName, runId) - 获取流水线运行状态"]
                FH_CancelPipelineRun["cancelPipelineRun(pipelineName, runId) - 取消流水线运行"]
            end
            
            subgraph AliCodeUpHelper["ali-codeup-helper.js - 代码仓库助手"]
                ACH_Constructor["constructor() - 初始化"]
                ACH_CreateBranchFromMaster["createBranchFromMaster(projectName, newBranchName) - 从主分支创建新分支"]
                ACH_DeleteBranch["deleteBranch(projectName, branchName) - 删除分支"]
            end
            
            subgraph RedisHelper["redis-helper.js - Redis 助手"]
                RH_Connect["connect() - 连接Redis"]
                RH_Client["client - Redis客户端实例"]
            end
            
            subgraph ApiUtils["apiUtils.js - API工具"]
                AU_Methods["各种API辅助方法"]
            end
            
            subgraph Constants["contants.js - 常量定义"]
                Constants_AppMap["APP_MAP - 应用映射"]
                Constants_TestFlowData["TEST_FLOW_DATA - 测试流数据"]
            end
        end
        
        %% 配置模块
        subgraph Config["配置模块"]
            subgraph ConstantsConfig["constants.js - 配置常量"]
                AccessTokens["ACCESS_TOKENS - 访问令牌"]
            end
            
            subgraph PipelineDependencies["pipelineDependencies.js - 管道依赖"]
                PD_Dependencies["PIPELINE_DEPENDENCIES - 管道依赖关系"]
            end
            
            subgraph RedisConfig["redis.js - Redis配置"]
                RC_Config["Redis连接配置"]
            end
        end
        
        %% 定时任务
        subgraph CronJobs["定时任务"]
            subgraph MasterDeployCron["masterDeployCron.js - 主分支部署定时任务"]
                MDC_Config["config - 配置信息"]
                MDC_GetAllPipelineNames["getAllPipelineNames() - 获取所有管道名称"]
                MDC_TriggerBatchDeployFunction["triggerBatchDeployFunction() - 触发批量部署"]
                MDC_ScheduleMasterDeploy["scheduleMasterDeploy() - 调度主分支部署"]
            end
        end
    end
    
    %% 基础设施
    subgraph Infrastructure["基础设施"]
        Docker["Docker 容器"]
        PM2["PM2 进程管理器"]
        Redis["Redis 数据库"]
        FlowPipeline["Flow 流水线平台"]
        AliCodeUp["阿里云代码仓库"]
    end

    %% ====================
    %% 连接关系
    %% ====================
    
    %% 前端到后端的连接
    Client --> BD_StartBatchDeploy
    Client --> BD_GetDeploymentStatus
    Client --> BD_GetRecentDeployments
    Client --> BD_StopDeployment
    Client --> BD_StopAllDeployments
    Client --> BD_RerunDeployment
    
    %% 路由层到服务层的连接
    BD_StartBatchDeploy --> BDS_StartBatchDeploy
    BD_GetDeploymentStatus --> DRS_GetTransaction
    BD_GetRecentDeployments --> DRS_GetRecentTransactions
    BD_StopDeployment --> BDS_CancelPipelineRun
    BD_StopDeployment --> DRS_UpdateTransactionStatus
    BD_StopAllDeployments --> BDS_CancelPipelineRun
    BD_RerunDeployment --> BDS_StartBatchDeploy
    
    %% 批量部署服务内部连接
    BDS_StartBatchDeploy --> BDS_GenerateTransactionId
    BDS_StartBatchDeploy --> BDS_HandleDependentProjects
    BDS_StartBatchDeploy --> DRS_SaveTransaction
    BDS_StartBatchDeploy --> BDS_StartProcessor
    BDS_HandleDependentProjects --> BDS_CreateAliCodeUpBranch
    BDS_StartProcessor --> BDS_ProcessDeployments
    BDS_StartProcessor --> BDS_CheckRunningPipelines
    BDS_ProcessDeployments --> BDS_GetBusySlotCount
    BDS_ProcessDeployments --> BDS_CreateAliCodeUpBranch
    BDS_ProcessDeployments --> BDS_DeployToFlow
    BDS_ProcessDeployments --> DRS_UpdateTransactionStatus
    BDS_CheckRunningPipelines --> DRS_GetDeploymentsByStatus
    BDS_CheckRunningPipelines --> DRS_UpdateTransactionStatus
    BDS_ShouldStopProcessor --> DRS_GetDeploymentsByStatus
    
    %% 批量部署服务到工具模块的连接
    BDS_CreateAliCodeUpBranch --> ACH_CreateBranchFromMaster
    BDS_DeployToFlow --> FH_TriggerPipelineRun
    BDS_GetBusySlotCount --> FH_GetPipelines
    BDS_CheckRunningPipelines --> FH_GetPipelineRun
    BDS_CancelPipelineRun --> FH_CancelPipelineRun
    
    %% Flow帮助类连接
    FH_Constructor --> AccessTokens
    FH_GetRepoUrlByPipelineId --> Constants_TestFlowData
    FH_GetPipelineIdByName --> Constants_TestFlowData
    
    %% AliCodeUp帮助类连接
    ACH_Constructor --> AccessTokens
    
    %% Redis连接
    DRS_AcquireLock --> RH_Client
    DRS_ReleaseLock --> RH_Client
    DRS_SavePipelineTransaction --> RH_Client
    DRS_SaveTransaction --> RH_Client
    DRS_GetTransaction --> RH_Client
    DRS_UpdateTransactionStatus --> RH_Client
    DRS_GetRecentTransactions --> RH_Client
    DRS_GetDeploymentsByStatus --> RH_Client
    
    %% 定时任务连接
    MDC_GetAllPipelineNames --> Constants_AppMap
    MDC_TriggerBatchDeployFunction --> MDC_GetAllPipelineNames
    MDC_TriggerBatchDeployFunction --> BDS_StartBatchDeploy
    MDC_ScheduleMasterDeploy --> MDC_TriggerBatchDeployFunction
    
    %% 服务到基础设施的连接
    ACH_CreateBranchFromMaster --> AliCodeUp
    ACH_DeleteBranch --> AliCodeUp
    FH_TriggerPipelineRun --> FlowPipeline
    FH_GetPipelineRun --> FlowPipeline
    FH_CancelPipelineRun --> FlowPipeline
    RH_Client --> Redis
    
    %% 类样式定义
    classDef service fill:#f9d5e5,stroke:#333,stroke-width:1px;
    classDef route fill:#eeeeee,stroke:#333,stroke-width:1px;
    classDef helper fill:#d5f9e8,stroke:#333,stroke-width:1px;
    classDef cron fill:#d5e5f9,stroke:#333,stroke-width:1px;
    classDef infrastructure fill:#f9f9d5,stroke:#333,stroke-width:1px;
    
    %% 应用样式
    class BatchDeployService,DeploymentRedisService service;
    class DockerRoutes,FlowRoutes,BatchDeployRoutes route;
    class FlowHelper,AliCodeUpHelper,RedisHelper,ApiUtils helper;
    class MasterDeployCron cron;
    class Docker,PM2,Redis,FlowPipeline,AliCodeUp infrastructure; 